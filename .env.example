# Copy to .env.local and fill in. None of these are required to run the app —
# without them Kobopilot falls back to simulated prices and scripted chat replies.

# --- AI chat (Kobo coach) — Vercel AI Gateway ---
# Paste an AI Gateway API key (Vercel dashboard → AI Gateway → API Keys).
# Without a key, /api/chat streams the offline scripted reply instead.
AI_GATEWAY_API_KEY=
# Optional. Any provider/model ID from https://ai-gateway.vercel.sh/v1/models.
# Defaults to openai/gpt-5-mini.
AI_GATEWAY_MODEL=
# Optional. Only applied to openai/gpt-5* models. Defaults to minimal for snappy replies.
AI_REASONING_EFFORT=

# --- NGX market data ---
# Tried in this order; the first provider returning 3+ quotes wins.
# If all are empty/failing, prices are deterministically simulated.
NGXPULSE_API_KEY=
TROVE_API_KEY=
TROVE_API_BASE=
TROVE_NGX_STOCKS_PATH=
ITICK_API_TOKEN=
